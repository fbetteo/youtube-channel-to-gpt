YOUTUBE_API_KEY=*your youtube api key*
# Protects /internal/docs and /debug/* (?secret=...). Leave empty to disable them.
DOCS_SECRET_KEY=

# Legacy unauthenticated Lambda result callbacks. Set to false once SQS delivery works.
ENABLE_HTTP_RESULT_CALLBACKS=true

# Single-video AI summaries (POST /summaries/single). Empty disables the feature.
SUMMARY_OPENAI_API_KEY=
SUMMARY_MODEL=gpt-4.1-mini
# Same value as the frontend's TRANSCRIPT_API_PROXY_SECRET (trusted visitor IP).
PROXY_SHARED_SECRET=
